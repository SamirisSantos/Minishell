{
   readline_leak_1
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:readline
}

{
   readline_leak_2
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libreadline.so.*
}

{
   readline_leak_3
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:add_history
}

{
   readline_cond
   Memcheck:Cond
   ...
   obj:*/libreadline.so.*
}

{
   readline_value8
   Memcheck:Value8
   ...
   obj:*/libreadline.so.*
}

{
   ignore_grep_all_kinds
   Memcheck:Leak
   ...
   obj:/usr/bin/grep
}

{
   ignore_clear_leaks
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:/usr/bin/clear
}

{
   ignore_ls_leaks
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:/usr/bin/ls
}